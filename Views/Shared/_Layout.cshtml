<!DOCTYPE html>
<html lang="kk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ProductCatalog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">ProductCatalog</a>
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Басты бет</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Product" asp-action="Index">Тауарлар</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <main class="container my-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-light text-center py-3 border-top">
        <div class="container text-muted">&copy; @DateTime.Now.Year ProductCatalog — Нурлаева Әсем, ИСК243</div>
    </footer>
</body>
</html>
